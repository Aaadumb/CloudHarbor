server{
    listen 127.0.0.1:80;
    client_max_body_size 8m;
    root /mnt/d/MProgram/CloudHarbor/frontend;
    location ^~ /_pages/{
        internal;
        alias /mnt/d/MProgram/CloudHarbor/frontend/;
        index login.html;
    }
    location ^~ /assets/{
        try_files $uri =404;
    }
    location ^~ /js/{
        try_files $uri =404;
    }
    location ^~ /css/{
        try_files $uri =404;
    }
    location /{
        # 前缀匹配不到才转交给普通匹配
        proxy_pass http://127.0.0.1:8080;
    }

    location ^~ /_download/group1/{
        internal;
        proxy_bind 127.0.0.2;
        proxy_pass http://storage_group1/group1/;
    }
}
upstream storage_group1{
    fair;
    server 127.0.0.1:8081;
}
server{
    listen 127.0.0.1:8081;
    allow 127.0.0.2;
    deny all;
    location /group1/{
        ngx_fastdfs_module;
    }
}